---
import tools from '../data/tools.json';
import { toolRows } from '../lib/tool-marquee';
import WidgetIcon from './WidgetIcon.astro';
import '../styles/tool-marquee.css';
---
<article class="welcome-widget widget-tools" data-widget="tools" aria-labelledby="tools-heading">
  <div class="tool-wall" aria-hidden="true">
    {toolRows(tools).map((row, index) => <div class="tool-row" style={`--row-shift:${index % 2 ? '-1.875rem' : '0rem'}`}>
      <div class="tool-track">
        {[0, 1].map(copy => <div class="tool-group" data-tool-copy={copy}>
          {row.map(tool => <span class="tool-icon" data-tool={tool.id} title={tool.name}><img src={tool.image} alt="" width="64" height="64" loading="eager" decoding="async" /></span>)}
        </div>)}
      </div>
    </div>)}
  </div>
  <div class="widget-heading"><WidgetIcon name="tools" /><h2 id="tools-heading">创作工具</h2></div>
  <ul class="sr-only" aria-label="创作工具列表">{tools.map(tool => <li>{tool.name}</li>)}</ul>
</article>
