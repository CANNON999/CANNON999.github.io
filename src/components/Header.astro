---
import profile from '../data/profile.json';
const { active = '' } = Astro.props;
---
<header class="page-header">
  <a class="wordmark" href="/" aria-label="CANNON，返回主页">CANNON<span>个人创作空间</span></a>
  <nav aria-label="主导航">
    <a href="/works/" aria-current={active === 'works' ? 'page' : undefined}>作品库</a>
    <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>关于我</a>
    <a href={`mailto:${profile.email}`}>联系 <span aria-hidden="true">↗</span></a>
  </nav>
</header>
