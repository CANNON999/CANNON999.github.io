---
import profile from '../data/profile.json';
import '../styles/navigation.css';
interface Props { active?: 'home' | 'works' | 'about' | ''; console?: boolean; }
const { active = '', console: onConsole = false } = Astro.props;
---
<header class:list={['site-header', { 'console-header': onConsole }]}>
  <nav class="section-nav" aria-label="主导航">
    <a id={onConsole ? 'home-link' : undefined} href={onConsole ? '/#welcome' : '/'} aria-current={active === 'home' ? 'page' : undefined}>个人主页</a>
    <a href="/works/" aria-current={active === 'works' ? 'page' : undefined}>作品集</a>
  </nav>
  <div class="header-right">
    <nav class="utility-nav" aria-label="个人信息">
      <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>关于我</a>
      <a href={`mailto:${profile.email}`}>联系</a>
    </nav>
    <a class="header-profile" href="/about/"><img class="header-avatar" src={profile.avatar} width="60" height="60" alt="" loading="eager" decoding="async" /><span>{profile.name}</span></a>
  </div>
</header>
